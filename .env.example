# Supabase (M0) — from Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard — random secret used as URL path: /admin/<key>/events
ADMIN_DASH_KEY=

# LINE Messaging API (M2)
LINE_CHANNEL_ACCESS_TOKEN=

# Gemini VLM (M3)
GEMINI_API_KEY=

# Claude — daily report summarizer (M5)
ANTHROPIC_API_KEY=

# Object detector on the worker (ADR-015) — off | shadow (detect + record, still call Gemini) | gate (skip Gemini when no person/vehicle)
YOLO_MODE=off
# Model is downloaded at worker start when missing (YOLOX-tiny, Apache-2.0, ~20 MB). Override to swap models.
YOLO_MODEL_URL=https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_tiny.onnx
YOLO_MODEL_PATH=models/yolox_tiny.onnx
# YOLO_CONF=0.3  YOLO_IOU=0.45  YOLO_TILES=4 (full frame + 2x2 tiles; 1 = full only)  YOLO_TIMEOUT_MS=3000  YOLO_THREADS=2  YOLO_LAYOUT=yolox|yolov8
