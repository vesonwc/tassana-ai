# Supabase (M0) — from Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard — random secret used as URL path: /admin/<key>/events
ADMIN_DASH_KEY=

# LINE Messaging API (M2)
LINE_CHANNEL_ACCESS_TOKEN=

# Gemini VLM (M3)
GEMINI_API_KEY=

# Claude — daily report summarizer (M5)
ANTHROPIC_API_KEY=
